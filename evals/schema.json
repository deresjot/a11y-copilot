{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sebastianjansen.com/a11y-copilot/evals/schema.json",
  "title": "a11y-copilot LLM evaluation cases",
  "type": "object",
  "required": ["schemaVersion", "lastReviewed", "cases"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "lastReviewed": { "type": "string", "format": "date" },
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "input", "must", "mustNot"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "input": { "type": "string", "minLength": 1 },
          "material": { "type": "string" },
          "must": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "mustNot": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
